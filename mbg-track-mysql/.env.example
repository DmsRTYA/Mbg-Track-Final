# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/mbg_track"

# ── WEB PUSH VAPID (jalankan: node scripts/generate-vapid.js untuk generate) ─
VAPID_PUBLIC_KEY="GENERATE_DENGAN_npm_run_generate-vapid"
VAPID_PRIVATE_KEY="GENERATE_DENGAN_npm_run_generate-vapid"
VAPID_SUBJECT="mailto:admin@mbg.go.id"

# ── NEXT_PUBLIC (tersedia di browser) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="SAMA_DENGAN_VAPID_PUBLIC_KEY_DI_ATAS"
